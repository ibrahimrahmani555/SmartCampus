DATABASE_URL=postgres://<user>:<password>@localhost:5432/<database_name>
PORT=3000
APP_BASE_URL=http://localhost:5173
# Select `development` to print the reset link in the backend console, or `resend` to send email.
MAIL_SENDER=resend
# Set your Resend API key in the local .env file; do not commit it.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
ALLOWED_EMAIL_DOMAIN=smartcampus.test,gmail.com
# Optional: when omitted, the seed uses a random password that is never logged.
SMARTCAMPUS_STAFF_TEST_PASSWORD=AMIN123
SMARTCAMPUS_STUDENT_TEST_PASSWORD=AMIN123
SMARTCAMPUS_ADMIN_TEST_PASSWORD=AMIN123
